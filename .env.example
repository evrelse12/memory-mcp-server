# LLM chat endpoint (llama-server)
MEMORY_LLM_API_URL=http://127.0.0.1:9931
MEMORY_LLM_MODEL=gemma-4-E4B-it-qat-UD-Q4_K_XL

# Embedding endpoint
MEMORY_EMBEDDING_API_URL=http://127.0.0.1:8081
MEMORY_EMBEDDING_MODEL=nomic-embed-text-v2-moe-q8_0
MEMORY_EMBEDDING_DIM=256

# Optional data locations
# MEMORY_DATA_DIR=/home/blake/memory

# Behaviour
MEMORY_SESSION_TIMEOUT_MINUTES=30
MEMORY_CONSOLIDATION_CRON_HOUR=3
MEMORY_CONSOLIDATION_CRON_MINUTE=0
MEMORY_DECAY_THRESHOLD=0.05
MEMORY_SOFT_DELETE_RETENTION_DAYS=30
MEMORY_EPISODE_RETENTION_DAYS=0
MEMORY_LOG_LEVEL=INFO
